  m_FontData:
    m_Font: {fileID: 12800000, guid: f0ab81afe8cd14f539d23f9f451a3af5, type: 3}
    m_FontSize: 50
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 300
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.08
  m_Text: "One by one, the sprouts crossed under a moonbow wicket. Beyond it, lunaria
    flowers dotted a dim path that meandered along \nthe nettlewood floor.\n\nTo
    show esteem, the lunaria bloomed aglow as promising sprouts padded by. A crescendoing
    band flared past the trustworthy, echoed by Songpetals who chimed nocturnes on
    the wind."
